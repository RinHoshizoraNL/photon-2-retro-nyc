"VertexlitGeneric"
{
	"$basetexture" "rin/transit/props/aerodynic/aerodynic"
	"$bumpmap" "sentry/props/aerodynic/aerodynic_nm"
    $phong "1"
    $phongexponent "7"
    $phongboost "1"
    $phongfresnelranges "[.05 .3 1]"
